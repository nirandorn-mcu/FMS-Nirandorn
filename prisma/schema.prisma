model Curriculum {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  code         String   @db.VarChar(50)
  nameTh       String   @map("name_th") @db.VarChar(255)
  nameEn       String   @map("name_en") @db.VarChar(255)
  degreeTh     String?  @map("degree_th") @db.VarChar(255)
  degreeEn     String?  @map("degree_en") @db.VarChar(255)
  faculty      String?  @db.VarChar(255)
  totalCredits Int      @default(0) @map("total_credits")
  revisionYear Int      @map("revision_year")
  status       String   @default("ACTIVE") @db.VarChar(50)

  durationYears      Int?     @default(4) @map("duration_years")
  studyType          String?  @map("study_type") @db.VarChar(255)
  campusLocation     String?  @map("campus_location") @db.VarChar(255)
  philosophy         String?  @db.Text
  objectives         String?  @db.Text
  careerPaths        String?  @map("career_paths") @db.Text
  admissionReq       String?  @map("admission_req") @db.Text
  tuitionFees        String?  @map("tuition_fees") @db.VarChar(255)
  graduationCriteria String?  @map("graduation_criteria") @db.Text
  plos               Json?    @default("[]")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subjects     CurriculumSubject[]

  @@index([tenantId])
  @@index([departmentId])
  @@map("curriculums")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  code        String       @db.VarChar(50)
  nameTh      String       @map("name_th") @db.VarChar(255)
  nameEn      String       @map("name_en") @db.VarChar(255)
  description String?      @db.Text
  status      String       @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculums Curriculum[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(255)
  nameEn      String   @map("name_en") @db.VarChar(255)
  credits     Int      @default(3)
  creditInfo  String?  @map("credit_info") @db.VarChar(50)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculums CurriculumSubject[]

  @@index([tenantId])
  @@map("subjects")
}

model CurriculumSubject {
  id           String     @id @default(uuid()) @db.Uuid
  curriculumId String     @map("curriculum_id") @db.Uuid
  subjectId    String     @map("subject_id") @db.Uuid
  category     String?    @db.VarChar(255)
  isCompulsory Boolean    @default(true) @map("is_compulsory")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, subjectId])
  @@map("curriculum_subjects")
}
