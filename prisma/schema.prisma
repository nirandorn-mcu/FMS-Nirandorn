// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs   AuditLog[]
  sampleItems SampleItem[]
  advanceRequests AdvanceRequest[]
  petitions   StudentPetition[]
  projects    Project[]
  documents   Document[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  authTokens  AuthToken[]
  auditLogs   AuditLog[]   @relation("AuditActor")
  borrowedAdvances   AdvanceRequest[]  @relation("AdvanceBorrower")
  approvedAdvances   AdvanceRequest[]  @relation("AdvanceApprover")
  disbursedAdvances  AdvanceRequest[]  @relation("AdvanceDisburser")
  clearedClearings   AdvanceClearing[] @relation("AdvanceClearingOfficer")
  submittedPetitions StudentPetition[] @relation("PetitionStudent")
  advisorPetitions   StudentPetition[] @relation("PetitionAdvisor")
  officerPetitions   StudentPetition[] @relation("PetitionOfficer")
  deanPetitions      StudentPetition[] @relation("PetitionDean")
  managedProjects    Project[]         @relation("ProjectManager")
  recordedProjectExpenses ProjectExpense[] @relation("ProjectExpenseRecorder")
  createdDocuments   Document[]        @relation("DocumentCreator")
  approvedDocSteps   DocumentWorkflowStep[] @relation("DocumentApprover")
  docComments        DocumentComment[] @relation("DocumentCommenter")

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

enum AdvanceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  DISBURSED
  CLEARED
  OVERDUE
}

enum ClearingStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdvanceRequest {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  reqNo           String        @map("req_no") @db.VarChar(50)
  borrowerId      String        @map("borrower_id") @db.Uuid
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  amount          Decimal       @db.Decimal(12, 2)
  eventStartDate  DateTime      @map("event_start_date") @db.Date
  eventEndDate    DateTime      @map("event_end_date") @db.Date
  dueDateClearing DateTime      @map("due_date_clearing") @db.Date
  status          AdvanceStatus @default(SUBMITTED)
  
  bankName        String?       @map("bank_name") @db.VarChar(100)
  bankAccountName String?       @map("bank_account_name") @db.VarChar(255)
  bankAccountNo   String?       @map("bank_account_no") @db.VarChar(50)

  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz()
  approverId      String?       @map("approver_id") @db.Uuid
  rejectionReason String?       @map("rejection_reason") @db.Text

  disbursedAt     DateTime?     @map("disbursed_at") @db.Timestamptz()
  disbursedById   String?       @map("disbursed_by_id") @db.Uuid

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  borrower        User          @relation("AdvanceBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  approver        User?         @relation("AdvanceApprover", fields: [approverId], references: [id], onDelete: SetNull)
  disburser       User?         @relation("AdvanceDisburser", fields: [disbursedById], references: [id], onDelete: SetNull)
  items           AdvanceItem[]
  clearing        AdvanceClearing?

  @@unique([tenantId, reqNo])
  @@index([tenantId, borrowerId])
  @@index([tenantId, status])
  @@map("advance_requests")
}

model AdvanceItem {
  id               String         @id @default(uuid()) @db.Uuid
  advanceRequestId String         @map("advance_request_id") @db.Uuid
  itemDescription  String         @map("item_description") @db.VarChar(255)
  estimatedAmount  Decimal        @map("estimated_amount") @db.Decimal(12, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  advanceRequest   AdvanceRequest @relation(fields: [advanceRequestId], references: [id], onDelete: Cascade)

  @@index([advanceRequestId])
  @@map("advance_items")
}

model AdvanceClearing {
  id                 String                @id @default(uuid()) @db.Uuid
  advanceRequestId   String                @unique @map("advance_request_id") @db.Uuid
  actualExpenseTotal Decimal               @map("actual_expense_total") @db.Decimal(12, 2)
  refundAmount       Decimal               @default(0) @map("refund_amount") @db.Decimal(12, 2)
  reimburseAmount    Decimal               @default(0) @map("reimburse_amount") @db.Decimal(12, 2)
  clearingDate       DateTime              @default(now()) @map("clearing_date") @db.Timestamptz()
  notes              String?               @db.Text
  receiptProofUrl    String?               @map("receipt_proof_url") @db.VarChar(500)
  clearedById        String?               @map("cleared_by_id") @db.Uuid
  status             ClearingStatus        @default(PENDING)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  advanceRequest     AdvanceRequest        @relation(fields: [advanceRequestId], references: [id], onDelete: Cascade)
  clearingOfficer    User?                 @relation("AdvanceClearingOfficer", fields: [clearedById], references: [id], onDelete: SetNull)
  items              AdvanceClearingItem[]

  @@map("advance_clearings")
}

model AdvanceClearingItem {
  id             String          @id @default(uuid()) @db.Uuid
  clearingId     String          @map("clearing_id") @db.Uuid
  receiptNo      String?         @map("receipt_no") @db.VarChar(100)
  receiptDate    DateTime        @map("receipt_date") @db.Date
  expenseTitle   String          @map("expense_title") @db.VarChar(255)
  amount         Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  clearing       AdvanceClearing @relation(fields: [clearingId], references: [id], onDelete: Cascade)

  @@index([clearingId])
  @@map("advance_clearing_items")
}

enum PetitionType {
  LATE_ENROLL
  LEAVE
  RESIGN
  TUITION_WAIVER
  COURSE_ADD_DROP
  GENERAL
}

enum PetitionStatus {
  SUBMITTED
  ADVISOR_APPROVED
  OFFICER_APPROVED
  DEAN_APPROVED
  REJECTED
  CANCELLED
}

model StudentPetition {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  ticketNo        String         @map("ticket_no") @db.VarChar(50)
  studentId       String         @map("student_id") @db.Uuid
  studentCode     String         @map("student_code") @db.VarChar(50)
  studentName     String         @map("student_name") @db.VarChar(255)
  studentEmail    String         @map("student_email") @db.VarChar(255)
  major           String         @db.VarChar(100)
  yearLevel       Int            @map("year_level")
  petitionType    PetitionType   @map("petition_type")
  title           String         @db.VarChar(255)
  details         String         @db.Text
  evidenceUrls    Json           @default("[]") @map("evidence_urls") @db.JsonB
  status          PetitionStatus @default(SUBMITTED)

  advisorId       String?        @map("advisor_id") @db.Uuid
  advisorComment  String?        @map("advisor_comment") @db.Text
  advisorActionAt DateTime?      @map("advisor_action_at") @db.Timestamptz()

  officerId       String?        @map("officer_id") @db.Uuid
  officerComment  String?        @map("officer_comment") @db.Text
  officerActionAt DateTime?      @map("officer_action_at") @db.Timestamptz()

  deanId          String?        @map("dean_id") @db.Uuid
  deanComment     String?        @map("dean_comment") @db.Text
  deanActionAt    DateTime?      @map("dean_action_at") @db.Timestamptz()

  rejectionReason String?        @map("rejection_reason") @db.Text

  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         User           @relation("PetitionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  advisor         User?          @relation("PetitionAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  officer         User?          @relation("PetitionOfficer", fields: [officerId], references: [id], onDelete: SetNull)
  dean            User?          @relation("PetitionDean", fields: [deanId], references: [id], onDelete: SetNull)
  logs            StudentPetitionLog[]

  @@unique([tenantId, ticketNo])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("student_petitions")
}

model StudentPetitionLog {
  id          String          @id @default(uuid()) @db.Uuid
  petitionId  String          @map("petition_id") @db.Uuid
  actorId     String?         @map("actor_id") @db.Uuid
  actorName   String          @map("actor_name") @db.VarChar(255)
  action      String          @db.VarChar(100)
  statusFrom  PetitionStatus? @map("status_from")
  statusTo    PetitionStatus  @map("status_to")
  comment     String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  petition    StudentPetition @relation(fields: [petitionId], references: [id], onDelete: Cascade)

  @@index([petitionId])
  @@map("student_petition_logs")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
}

enum BudgetSource {
  GOVERNMENT
  REVENUE
  RESEARCH_GRANT
  DONATION
  OTHER
}

enum KpiStatus {
  PENDING
  ON_TRACK
  AT_RISK
  ACHIEVED
}

model Project {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  code                String        @db.VarChar(50)
  nameTh              String        @map("name_th") @db.VarChar(255)
  nameEn              String?       @map("name_en") @db.VarChar(255)
  fiscalYear          Int           @map("fiscal_year")
  strategicPlan       String?       @map("strategic_plan") @db.VarChar(255)
  budgetSource        BudgetSource  @default(REVENUE) @map("budget_source")
  allocatedBudget     Decimal       @map("allocated_budget") @db.Decimal(12, 2)
  spentBudget         Decimal       @default(0) @map("spent_budget") @db.Decimal(12, 2)
  responsiblePersonId String        @map("responsible_person_id") @db.Uuid
  startDate           DateTime      @map("start_date") @db.Date
  endDate             DateTime      @map("end_date") @db.Date
  status              ProjectStatus @default(PLANNED)
  description         String?       @db.Text

  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsiblePerson   User          @relation("ProjectManager", fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  kpis                ProjectKpi[]
  expenses            ProjectExpense[]

  @@unique([tenantId, code])
  @@index([tenantId, fiscalYear])
  @@index([tenantId, status])
  @@map("projects")
}

model ProjectKpi {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  indicatorName String    @map("indicator_name") @db.VarChar(255)
  targetValue   Decimal   @map("target_value") @db.Decimal(10, 2)
  actualValue   Decimal   @default(0) @map("actual_value") @db.Decimal(10, 2)
  unit          String    @db.VarChar(50)
  status        KpiStatus @default(PENDING)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_kpis")
}

model ProjectExpense {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  title        String   @db.VarChar(255)
  amount       Decimal  @db.Decimal(12, 2)
  expenseDate  DateTime @map("expense_date") @db.Date
  receiptRef   String?  @map("receipt_ref") @db.VarChar(100)
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation("ProjectExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("project_expenses")
}

enum DocumentType {
  MEMO
  ANNOUNCEMENT
  ORDER
  PETITION
  CONTRACT
  REPORT
  OTHER
}

enum DocumentUrgency {
  NORMAL
  URGENT
  VERY_URGENT
  MOST_URGENT
}

enum DocumentConfidentiality {
  NORMAL
  CONFIDENTIAL
  VERY_CONFIDENTIAL
  TOP_SECRET
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model Document {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  docNo           String                  @map("doc_no") @db.VarChar(50)
  title           String                  @db.VarChar(255)
  docType         DocumentType            @default(MEMO) @map("doc_type")
  urgency         DocumentUrgency         @default(NORMAL)
  confidentiality DocumentConfidentiality @default(NORMAL)
  creatorId       String                  @map("creator_id") @db.Uuid
  currentStep     Int                     @default(1) @map("current_step")
  totalSteps      Int                     @default(1) @map("total_steps")
  status          DocumentStatus          @default(DRAFT)
  content         String?                 @db.Text
  attachmentUrl   String?                 @map("attachment_url") @db.VarChar(500)
  tags            Json                    @default("[]") @db.JsonB
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator         User                    @relation("DocumentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  workflowSteps   DocumentWorkflowStep[]
  comments        DocumentComment[]

  @@unique([tenantId, docNo])
  @@index([tenantId, status])
  @@index([tenantId, creatorId])
  @@map("documents")
}

model DocumentWorkflowStep {
  id           String             @id @default(uuid()) @db.Uuid
  documentId   String             @map("document_id") @db.Uuid
  stepNumber   Int                @map("step_number")
  approverRole String             @map("approver_role") @db.VarChar(100)
  approverId   String?            @map("approver_id") @db.Uuid
  status       WorkflowStepStatus @default(PENDING)
  comment      String?            @db.Text
  signatureUrl String?            @map("signature_url") @db.VarChar(500)
  actionAt     DateTime?          @map("action_at") @db.Timestamptz()

  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver     User?              @relation("DocumentApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([approverId])
  @@map("document_workflow_steps")
}

model DocumentComment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  comment    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation("DocumentCommenter", fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_comments")
}



